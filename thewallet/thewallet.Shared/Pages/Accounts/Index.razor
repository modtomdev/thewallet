@page "/accounts"

@inject IFormFactor FormFactor
@inject IFrontService FrontService
@inject NavigationManager NavigationManager

<PageTitle>Accounts</PageTitle>
<h1 class="mt-4 mb-4">YOUR ACCOUNTS:</h1>

@foreach (var item in _accountsWithGraphs)
{
    <div class="container mb-4 p-3 shadow rounded bg-white">
        <div class="row align-items-center">

            <div class="col-md-5 clickable p-2"
                 style="cursor: pointer;"
                 @onclick="() => OnAccountClick(item.Account)">
                <h4>@item.Account.AccountName</h4>
                <p><strong>Totale:</strong> @item.Account.TotalValueEur €</p>
            </div>

            <div class="col-md-7">
                @if (_graphsAreLoading)
                {
                    <div class="text-muted">Loading chart data...</div>
                }
                else
                {
                    <ApexChart TItem="GraphSnapshotDTO"
                               Title=""
                               Height="280">
                        <ApexPointSeries TItem="GraphSnapshotDTO"
                                         Items="item.Graphs"
                                         Name="Account Value"
                                         SeriesType="SeriesType.Area"
                                         XValue="e => e.SnapshotTimestamp"
                                         YValue="e => e.TotalValueEur" />
                    </ApexChart>
                }
            </div>
        </div>
    </div>
}



